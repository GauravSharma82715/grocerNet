# Server Port
PORT=5000

# PostgreSQL Database Connection String (e.g. Neon Serverless Postgres)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.aws.neon.tech/neondb?sslmode=require"

# JWT Secret Key
JWT_SECRET="your_jwt_secret_key_here"

# Comma-separated Admin Email Addresses (grants admin privileges)
ADMIN_EMAILS="admin@example.com"

# Cloudinary Media Storage Credentials
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# SMTP Email Configuration (Nodemailer / Brevo)
SENDER_EMAIL="notifications@yourdomain.com"
SMTP_USER="your_smtp_username"
SMTP_PASS="your_smtp_password"

# Razorpay Payment Gateway Credentials (Test or Live)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"

# Client Web App URL (for email links and CORS)
CLIENT_URL="http://localhost:5173"
